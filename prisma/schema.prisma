// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  SALES_REP
}

enum OpportunityStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(SALES_REP)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contacts      Contact[]      @relation("ContactCreatedBy")
  assignedContacts Contact[]   @relation("ContactAssignedTo")
  opportunities Opportunity[]  @relation("OpportunityCreatedBy")
  assignedOpportunities Opportunity[] @relation("OpportunityAssignedTo")
  opportunityHistories  OpportunityHistory[]

  @@map("users")
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  email     String?  @unique
  phone     String?
  address   String?
  notes     String?
  tags      String[] // Array of tags for categorization

  createdById String
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  createdBy    User           @relation("ContactCreatedBy", fields: [createdById], references: [id])
  assignedTo   User?          @relation("ContactAssignedTo", fields: [assignedToId], references: [id])
  opportunities Opportunity[]

  @@map("contacts")
}

model Opportunity {
  id          String           @id @default(cuid())
  title       String
  description String?
  value       Decimal?         @db.Decimal(12, 2)
  currency    String           @default("USD")
  stage       OpportunityStage
  probability Int?             @default(0)
  closeDate   DateTime?

  contactId    String
  createdById  String
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  assignedTo  User?    @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id])
  history     OpportunityHistory[]

  @@map("opportunities")
}

model OpportunityHistory {
  id            String           @id @default(cuid())
  opportunityId String
  previousStage OpportunityStage?
  newStage      OpportunityStage
  changeReason  String?
  changedById   String
  changedAt     DateTime         @default(now())

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@map("opportunity_history")
}
